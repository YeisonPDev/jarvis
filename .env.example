# Copia este archivo como ".env" y pon tu llave en JARVIS_API_KEY.
# El archivo .env NUNCA debe subirse a git (ya está en .gitignore).

# --- Proveedor por defecto: Groq ---
JARVIS_PROVIDER=groq
JARVIS_MODEL=openai/gpt-oss-120b
JARVIS_BASE_URL=https://api.groq.com/openai/v1
JARVIS_API_KEY=

# --- Alternativa: Ollama local (comenta el bloque de Groq y descomenta este) ---
# JARVIS_PROVIDER=ollama
# JARVIS_MODEL=qwen3:4b
# JARVIS_BASE_URL=http://localhost:11434/v1
# JARVIS_API_KEY=

# --- Búsqueda en internet (opcional) ---
# Usa la búsqueda integrada de Groq. Si JARVIS_PROVIDER=groq se usa JARVIS_API_KEY;
# con otro proveedor (Ollama, Anthropic) pon aquí una llave de Groq para poder buscar.
JARVIS_GROQ_API_KEY=

# --- Voz (texto a voz) con OpenAI, voz "onyx" ---
# Llave de https://platform.openai.com/api-keys (es distinta a la de Groq).
# Si queda vacía, Jarvis usa la voz de Windows.
JARVIS_TTS_API_KEY=

# --- Futuro: Anthropic ---
# JARVIS_PROVIDER=anthropic
# JARVIS_MODEL=claude-sonnet-5-5
# JARVIS_BASE_URL=
# JARVIS_API_KEY=
